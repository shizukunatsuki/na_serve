#!/bin/zsh -f
# serve: temporary HTTP file server, optionally with a public tunnel
#
# Usage: serve [--share]
#
# Serve the current directory with Caddy on a kernel-assigned port (LAN).
# With --share, also open a cloudflared quick tunnel (public) and show its
# address; without it, nothing leaves the local network. Ctrl-C stops
# everything. Signals are only ever sent to our own process group: serve, its
# services, and whatever else the invoking shell put in the same job (the
# rest of a pipeline serve runs in, which stops along with it). Nothing
# outside that can be killed by mistake. Several instances can run at once,
# each on its own port.
#
# The invoking shell runs this script as a foreground job in a process group
# of its own; job control stays off in here, so caddy and cloudflared land in
# that same group. -f keeps ~/.zshenv out, so nothing in the environment can
# redefine what runs below.

# Background jobs would otherwise be niced, interactive shell or not
setopt nobgnice

zmodload zsh/system zsh/zselect || exit 1

# Every signal that stops serve; see the cleanup traps further down for why
# exactly these.
typeset -a stop_signals=(INT HUP TERM QUIT PIPE ALRM USR1 USR2 VTALRM PROF XCPU XFSZ
  ABRT EMT SYS)

# Until the services start, a stop signal ends serve at once, with 128 + the
# signal number. Left to their default actions they would mostly do that too,
# but zsh ignores QUIT and turns HUP into exit 1, and serve may be waiting on
# a helper (scutil) that a signal sent to serve alone never reaches: it would
# run on after serve. So each gets a trap that first sends TERM to serve's own
# process group, helper included. Before the leader check below, that group
# may not exist; the kill then reaches nobody, which is still right, since
# nothing has been started. The cleanup traps replace these.
for sig in $stop_signals; do
  trap "trap '' \$stop_signals; kill -TERM -\$\$ 2>/dev/null; exit $(( ${signals[(ie)$sig]} - 1 + 128 ))" $sig
done

# The public tunnel is opt-in: exposing a directory to the whole internet
# should never be what happens by default.
typeset arg share=0
for arg; do
  case $arg in
    --share) share=1 ;;
    -h|--help)
      print "usage: serve [--share]"
      print "  Serve the current directory on the local network."
      print "  --share  also open a public cloudflared quick tunnel"
      exit 0
      ;;
    *)
      print -ru2 -- "serve: unknown option: $arg"
      print -u2 "usage: serve [--share]"
      exit 2
      ;;
  esac
done

# Everything serve shells out to. A missing helper is checked here so it
# fails with its own name, instead of surfacing later as a symptom that
# points at the wrong thing: without lsof the port simply never turns up,
# which is indistinguishable from caddy never managing to listen.
# cloudflared only matters when there is a tunnel to open, and so does curl,
# which asks it for the tunnel's address.
typeset cmd
typeset -a needed=(caddy)
(( share )) && needed+=(cloudflared curl)
needed+=(scutil lsof ps)
for cmd in $needed; do
  if (( ! $+commands[$cmd] )); then
    print -u2 "serve: $cmd not found"
    exit 1
  fi
done

typeset port line
typeset host=$(scutil --get LocalHostName 2>/dev/null)
# $PPID is fixed at startup; sysparams[ppid] asks the kernel every time, which
# is what noticing the parent shell's death needs
typeset parent=$sysparams[ppid]
typeset caddy_pid cf_pid stop=0 rc=0 i
typeset addr body public
typeset -F public_deadline=0

# All signals below target our own process group; refuse to run without one.
# A group whose ID is our PID exists exactly when we lead it, so the kernel
# answers this directly: no ps output to parse or trust. If this passed while
# we were not a leader, every kill -$$ below would hit nothing, and caddy and
# cloudflared would outlive us.
if ! kill -0 -$$ 2>/dev/null; then
  print -u2 "serve: not a process group leader, refusing to start"
  exit 1
fi

# Every way the terminal or the parent shell can tell us to stop, Ctrl-\
# included: an untrapped SIGQUIT would end this script without the cleanup
# below, leaving whatever ignores SIGQUIT running. SIGPIPE likewise: when
# our output is piped into something that has already exited (say,
# `serve 2>&1 | head -3`), the next message we print would otherwise kill us
# on the spot and leave caddy serving, orphaned; trapped, serve stops as a
# whole instead. The rest are every other signal whose default action would
# end us just as abruptly: rarely sent, but a stray `kill -USR1` must not
# orphan anything either. ABRT and SYS are safe to trap too: abort() still
# ends the process once the trap returns, and a bad system call just fails
# with ENOSYS. Faults that re-run the faulting instruction when the handler
# returns (SEGV, BUS, ILL, FPE, TRAP) are left alone, since trapping a real
# one would only loop; like SIGKILL, they are beyond what a script can catch.
trap 'stop=1' $stop_signals

# Services an earlier serve left behind (see the README's known limitations:
# killed outright, or stuck on a hung lsof after its shell went away) keep
# running, the directory still exposed, and nothing else would ever mention
# them. This check is the only safety net for that, so it errs on the side of
# saying too much: every caddy and cloudflared is listed, whatever its
# arguments (an older serve may have used others), unless its parent is a
# serve that is still running normally, that is, one whose own parent is not
# launchd. A serve that launchd has adopted is listed as well: it has lost
# its shell without noticing, so it is stuck. Nothing listed is touched:
# telling a leftover from someone's own process is the user's call, and
# killing on a guess is not serve's. Command lines are written with control
# characters replaced, so no process can put escape sequences on the
# terminal through them. If ps fails, saying nothing would read as "no
# leftovers", so that is said instead.
typeset -a strays pgids f
typeset cmdline out pid pp
typeset -A ppid_of pgid_of cmd_of
# zsh running a script called serve, as `serve` itself shows up in ps
is_serve() { [[ $1 == (*/|)zsh' -f '(*/|)serve(|' '*) ]] }
out=$(ps -A -ww -o pid=,ppid=,pgid=,command= 2>/dev/null)
if (( $? )) || [[ -z $out ]]; then
  print -u2 "serve: could not check for services left behind (ps failed)"
fi
for line in ${(f)out}; do
  f=(${=line})
  (( $#f >= 4 )) || continue
  ppid_of[$f[1]]=$f[2] pgid_of[$f[1]]=$f[3] cmd_of[$f[1]]=${f[4,-1]}
done
for pid in ${(kon)cmd_of}; do
  (( pid == $$ )) && continue
  cmdline=$cmd_of[$pid]
  f=(${=cmdline})
  if [[ ${f[1]:t} == (caddy|cloudflared) || ${f[2]:t} == (caddy|cloudflared) ]]; then
    pp=$ppid_of[$pid]
    is_serve "$cmd_of[$pp]" && (( ppid_of[$pp] != 1 )) && continue
  elif ! { is_serve "$cmdline" && (( ppid_of[$pid] == 1 )) }; then
    continue
  fi
  strays+=("    PID $pid  PGID $pgid_of[$pid]  ${cmdline//[^[:print:]]/?}")
  (( ${pgids[(Ie)$pgid_of[$pid]]} )) || pgids+=($pgid_of[$pid])
done
if (( $#strays )); then
  typeset warn= off=
  [[ -t 2 ]] && { warn=$'\e[33m'; off=$'\e[0m' }
  print -ru2 -- "
${warn}── serve: warning ─────────────────────────────${off}
  These caddy/cloudflared processes do not belong to a serve that is
  still running normally. Unless you started them yourself, they may
  be left behind by an earlier serve and still expose a directory:
${(F)strays}
  To end them: ${(j:, :)${(@)pgids/#/kill -KILL -}}
${warn}───────────────────────────────────────────────${off}"
fi

{
  # Port 0 makes the kernel hand out a free ephemeral port. A fixed port would
  # not be safe: Caddy sets SO_REUSEPORT, so a second instance would silently
  # share a busy port instead of failing, and all traffic would keep going to
  # the first one.
  caddy file-server --browse --listen :0 </dev/null &
  caddy_pid=$!

  # Wait until caddy is listening and read back the port it was given. Caddy
  # opens a single dual-stack listener for :0, so the first address lsof
  # reports is the only one. The window is generous because the first launch
  # of a freshly installed binary can sit in macOS's malware scan for a few
  # seconds before it runs at all. A Ctrl-C during the poll also hits lsof
  # (same process group); the loop then ends through the trap on the next turn.
  # The window is measured on the clock, not in turns: each turn also forks
  # lsof, which under load stretched a hundred 0.1s turns to over 13 seconds.
  typeset -F SECONDS
  typeset -F deadline=$(( SECONDS + 10 ))
  while (( SECONDS < deadline )); do
    for line in ${(f)"$(lsof -nP -a -p $caddy_pid -iTCP -sTCP:LISTEN -Fn 2>/dev/null)"}; do
      [[ $line == n*:<-> ]] || continue
      port=${line##*:}
      # Anything but a real TCP port number means lsof misbehaved; it must
      # not reach cloudflared as part of a URL. The length check keeps
      # absurd input away from the arithmetic, which would warn about it.
      (( ${#port} <= 5 && port > 0 && port <= 65535 )) || port=
      break
    done
    [[ -n $port ]] && break
    # A parent gone during startup is a stop like any other, rather than
    # something noticed only once the services are up
    (( sysparams[ppid] == parent )) || stop=1
    (( stop )) && break
    kill -0 $caddy_pid 2>/dev/null || break
    zselect -t 10
  done

  if (( stop )); then
    # Interrupted during startup (or the parent is gone): caddy may have had
    # the same signal, so its state says nothing, and nothing else gets started
    :
  elif ! kill -0 $caddy_pid 2>/dev/null; then
    print -u2 "serve: caddy failed to start"
    rc=1
  elif [[ -z $port ]]; then
    print -u2 "serve: could not read the port caddy is listening on"
    rc=1
  else
    # Anyone on the LAN (and with --share, anyone at all) can read this, with
    # nothing hidden (dotfiles included), so it has to be easy to find among
    # the services' logs: one framed block, written once. With --share it
    # waits for the tunnel's address, so that everything is in one place
    # rather than repeated. Styles only on a terminal (in a file or a pipe the
    # codes would just be noise), spelled out as escape codes because a
    # non-interactive zsh has no terminal capabilities for %B, and kept sparse
    # so that what matters stands out: frame and labels dimmed, the directory
    # in bold, addresses underlined, and one colour, yellow, for Public:, the
    # address anyone on the internet can use. The block goes out in a single
    # write, so no log line can land inside it, after a newline of its own,
    # so it never continues a log line that is still being written.
    typeset dim= bold= ul= yellow= off= url note=
    [[ -t 1 ]] && { dim=$'\e[2m'; bold=$'\e[1m'; ul=$'\e[4m'; yellow=$'\e[33m'; off=$'\e[0m' }
    if [[ -n $host ]]; then
      url="http://${host}.local:${port}/"
    else
      url="http://localhost:${port}/"
      note=" (LocalHostName is not set, so there is no .local name)"
    fi
    # With --share, $1 is what goes after Public:
    show() {
      local extra=
      (( share )) && extra=$'\n'"  ${yellow}Public:${off}  $1"
      print -r -- "
${dim}── serve ──────────────────────────────────────${off}
  ${dim}Serving:${off} ${bold}${PWD}${off}
  ${dim}Local:${off}   ${ul}${url}${off}${note}${extra}
${dim}───────────────────────────────────────────────${off}"
    }
    if (( share )); then
      cloudflared tunnel --url "http://localhost:${port}" </dev/null &
      cf_pid=$!
      # A quick tunnel usually has its address within seconds; past this,
      # something is wrong enough to show the block without it rather than
      # keep the LAN address back any longer
      public_deadline=$(( SECONDS + 30 ))
    else
      show
    fi

    # Run until interrupted, a service exits, or the parent shell dies. A
    # service found gone right after an interrupt is not an error: the same
    # signal reached it directly, and the cleanup below is about to run anyway.
    while (( ! stop && sysparams[ppid] == parent )); do
      if ! kill -0 $caddy_pid 2>/dev/null; then
        (( stop )) || { print -u2 "serve: caddy exited"; rc=1 }
        break
      fi
      if [[ -n $cf_pid ]] && ! kill -0 $cf_pid 2>/dev/null; then
        (( stop )) || { print -u2 "serve: cloudflared exited"; rc=1 }
        break
      fi

      # The public address, as this instance's own cloudflared reports it:
      # once it has one, it opens a metrics server on localhost that answers
      # GET /quicktunnel with {"hostname":"..."}. That server's port depends
      # on what other cloudflareds already hold (it tries 20241-20245, then
      # any), so it is found by PID, like caddy's; a fixed port could be
      # another instance's, and show its address for this directory. Its log
      # carries the address too, but reading that would mean piping it
      # through serve. Only a plain host name is ever printed: whatever else
      # comes back could carry escape sequences onto the terminal.
      if (( public_deadline )); then
        for line in ${(f)"$(lsof -nP -a -p $cf_pid -iTCP -sTCP:LISTEN -Fn 2>/dev/null)"}; do
          [[ $line == n*:<-> ]] || continue
          addr=${line#n}
          [[ $addr == '*:'* ]] && addr=127.0.0.1:${addr#*:}
          # -q first, so no ~/.curlrc applies; no proxy for a local address;
          # and a time limit, so an answer that never comes holds up nothing
          body=$(curl -q -s --noproxy '*' --max-time 1 "http://${addr}/quicktunnel" 2>/dev/null)
          [[ $body == *'"hostname":"'* ]] || continue
          public=${${body#*\"hostname\":\"}%%\"*}
          if [[ -n $public && ${#public} -le 253 && $public != *[^A-Za-z0-9.-]* ]]; then
            show "${ul}https://${public}/${off}"
            public_deadline=0
            break
          fi
        done
        if (( public_deadline && SECONDS >= public_deadline )); then
          show "unknown, look for it in cloudflared's log"
          public_deadline=0
        fi
      fi
      zselect -t 50
    done
  fi
} always {
  # Stop everything in our process group (never signal bare PIDs). This runs
  # however the block above ends, including when zsh aborts it on an error of
  # its own: a failed write to a closed stdout or stderr is such an error, and
  # would otherwise end the script right there, skipping this cleanup.
  (( TRY_BLOCK_ERROR )) && rc=1
  trap '' $stop_signals
  kill -TERM -$$
  kill -CONT -$$
  for i in {1..50}; do
    kill -0 $caddy_pid 2>/dev/null ||
      { [[ -n $cf_pid ]] && kill -0 $cf_pid 2>/dev/null } || exit $rc
    # Still running after half a second almost always means draining a
    # transfer in progress, which caddy would wait on forever. Both stop at
    # once on a repeated signal, but not the same one: caddy only on a second
    # SIGINT, cloudflared on a second anything, except that after its first
    # it stops handling signals and SIGINT is back to ignored (as every
    # background job starts), so only another TERM reaches it. Send both,
    # twice; after a Ctrl-C each has already had its first.
    (( i == 5 || i == 10 )) && { kill -INT -$$; kill -TERM -$$ }
    zselect -t 10
  done
  kill -KILL -$$
}
