#!/bin/zsh -f
# serve: temporary HTTP file server, optionally with a public tunnel
#
# Usage: serve [--share]
#
# Serve the current directory with Caddy on a kernel-assigned port (LAN).
# With --share, also open a cloudflared quick tunnel (public); without it,
# nothing leaves the local network. Ctrl-C stops everything. Signals are only
# ever sent to our own process group, so nothing outside `serve` can be killed
# by mistake. Several instances can run at once, each on its own port.
#
# The invoking shell runs this script as a foreground job in a process group
# of its own; job control stays off in here, so caddy and cloudflared land in
# that same group. -f keeps ~/.zshenv out, so nothing in the environment can
# redefine what runs below.

# Background jobs would otherwise be niced, interactive shell or not
setopt nobgnice

zmodload zsh/system zsh/zselect || exit 1

# The public tunnel is opt-in: exposing a directory to the whole internet
# should never be what happens by default.
typeset arg share=0
for arg; do
  case $arg in
    --share) share=1 ;;
    -h|--help)
      print "usage: serve [--share]"
      print "  Serve the current directory on the local network."
      print "  --share  also open a public cloudflared quick tunnel"
      exit 0
      ;;
    *)
      print -ru2 -- "serve: unknown option: $arg"
      print -u2 "usage: serve [--share]"
      exit 2
      ;;
  esac
done

# Everything serve shells out to. A missing helper is checked here so it
# fails with its own name, instead of surfacing later as a symptom that
# points at the wrong thing: without lsof the port simply never turns up,
# which is indistinguishable from caddy never managing to listen.
# cloudflared only matters when there is a tunnel to open.
typeset cmd
typeset -a needed=(caddy)
(( share )) && needed+=(cloudflared)
needed+=(scutil lsof)
for cmd in $needed; do
  if (( ! $+commands[$cmd] )); then
    print -u2 "serve: $cmd not found"
    exit 1
  fi
done

typeset port line
typeset host=$(scutil --get LocalHostName 2>/dev/null)
# $PPID is fixed at startup; sysparams[ppid] asks the kernel every time, which
# is what noticing the parent shell's death needs
typeset parent=$sysparams[ppid]
typeset caddy_pid cf_pid stop=0 rc=0 i

# All signals below target our own process group; refuse to run without one.
# A group whose ID is our PID exists exactly when we lead it, so the kernel
# answers this directly: no ps output to parse or trust. If this passed while
# we were not a leader, every kill -$$ below would hit nothing, and caddy and
# cloudflared would outlive us.
if ! kill -0 -$$ 2>/dev/null; then
  print -u2 "serve: not a process group leader, refusing to start"
  exit 1
fi

# Every way the terminal or the parent shell can tell us to stop, Ctrl-\
# included: an untrapped SIGQUIT would end this script without the cleanup
# below, leaving whatever ignores SIGQUIT running. SIGPIPE likewise: when
# our output is piped into something that has already exited (say,
# `serve --share 2>&1 | grep -m1 trycloudflare`), the next message we print
# would otherwise kill us on the spot and leave caddy serving, orphaned.
# The rest are every other signal whose default action would end us just as
# abruptly: rarely sent, but a stray `kill -USR1` must not orphan anything
# either. Faults (SEGV and the like) are left alone, since trapping a real
# one would only loop; like SIGKILL, they are beyond what a script can catch.
typeset -a stop_signals=(INT HUP TERM QUIT PIPE ALRM USR1 USR2 VTALRM PROF XCPU XFSZ)
trap 'stop=1' $stop_signals

{
  # Port 0 makes the kernel hand out a free ephemeral port. A fixed port would
  # not be safe: Caddy sets SO_REUSEPORT, so a second instance would silently
  # share a busy port instead of failing, and all traffic would keep going to
  # the first one.
  caddy file-server --browse --listen :0 </dev/null &
  caddy_pid=$!

  # Wait until caddy is listening and read back the port it was given. Caddy
  # opens a single dual-stack listener for :0, so the first address lsof
  # reports is the only one. The window is generous because the first launch
  # of a freshly installed binary can sit in macOS's malware scan for a few
  # seconds before it runs at all. A Ctrl-C during the poll also hits lsof
  # (same process group); the loop then ends through the trap on the next turn.
  # The window is measured on the clock, not in turns: each turn also forks
  # lsof, which under load stretched a hundred 0.1s turns to over 13 seconds.
  typeset -F SECONDS
  typeset -F deadline=$(( SECONDS + 10 ))
  while (( SECONDS < deadline )); do
    for line in ${(f)"$(lsof -nP -a -p $caddy_pid -iTCP -sTCP:LISTEN -Fn 2>/dev/null)"}; do
      [[ $line == n*:<-> ]] || continue
      port=${line##*:}
      # Anything but a real TCP port number means lsof misbehaved; it must
      # not reach cloudflared as part of a URL. The length check keeps
      # absurd input away from the arithmetic, which would warn about it.
      (( ${#port} <= 5 && port > 0 && port <= 65535 )) || port=
      break
    done
    [[ -n $port ]] && break
    (( stop )) && break
    kill -0 $caddy_pid 2>/dev/null || break
    zselect -t 10
  done

  if (( stop )); then
    # Interrupted during startup: the same signal also reached caddy directly,
    # so its state says nothing, and nothing else gets started
    :
  elif ! kill -0 $caddy_pid 2>/dev/null; then
    print -u2 "serve: caddy failed to start"
    rc=1
  elif [[ -z $port ]]; then
    print -u2 "serve: could not read the port caddy is listening on"
    rc=1
  else
    # Anyone on the LAN (and with --share, anyone at all) can read this, with
    # nothing hidden (dotfiles included), so make the exposed directory hard to
    # miss: bold red, spelled out as escape codes because a non-interactive zsh
    # has no terminal capabilities for %B.
    print -r -- $'\e[1;31m'"Serving: ${PWD}"$'\e[0m'
    if [[ -n $host ]]; then
      print "Local: http://${host}.local:${port}/"
    else
      print "Local: http://localhost:${port}/ (LocalHostName is not set, so there is no .local name)"
    fi
    if (( share )); then
      cloudflared tunnel --url "http://localhost:${port}" </dev/null &
      cf_pid=$!
    fi

    # Run until interrupted, a service exits, or the parent shell dies. A
    # service found gone right after an interrupt is not an error: the same
    # signal reached it directly, and the cleanup below is about to run anyway.
    while (( ! stop && sysparams[ppid] == parent )); do
      if ! kill -0 $caddy_pid 2>/dev/null; then
        (( stop )) || { print -u2 "serve: caddy exited"; rc=1 }
        break
      fi
      if [[ -n $cf_pid ]] && ! kill -0 $cf_pid 2>/dev/null; then
        (( stop )) || { print -u2 "serve: cloudflared exited"; rc=1 }
        break
      fi
      zselect -t 50
    done
  fi
} always {
  # Stop everything in our process group (never signal bare PIDs). This runs
  # however the block above ends, including when zsh aborts it on an error of
  # its own: a failed write to a closed stdout or stderr is such an error, and
  # would otherwise end the script right there, skipping this cleanup.
  (( TRY_BLOCK_ERROR )) && rc=1
  trap '' $stop_signals
  kill -TERM -$$
  kill -CONT -$$
  for i in {1..50}; do
    kill -0 $caddy_pid 2>/dev/null ||
      { [[ -n $cf_pid ]] && kill -0 $cf_pid 2>/dev/null } || exit $rc
    # Still running after half a second almost always means draining a
    # transfer in progress, which caddy would wait on forever. Both stop at
    # once on a repeated signal, but not the same one: caddy only on a second
    # SIGINT, cloudflared on a second anything, except that after its first
    # it stops handling signals and SIGINT is back to ignored (as every
    # background job starts), so only another TERM reaches it. Send both,
    # twice; after a Ctrl-C each has already had its first.
    (( i == 5 || i == 10 )) && { kill -INT -$$; kill -TERM -$$ }
    zselect -t 10
  done
  kill -KILL -$$
}
